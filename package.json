{
  "name": "lo-agent",
  "version": "0.1.0",
  "description": "lo Agent 桌面端",
  "main": "src/main/index.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "test": "jest --passWithNoTests",
    "lint": "eslint \"src/**/*.{cjs,jsx}\" \"test/**/*.cjs\"",
    "format": "prettier --write \"src/**/*.{cjs,jsx}\" \"test/**/*.cjs\"",
    "prepare": "husky"
  },
  "keywords": [
    "lo",
    "agent",
    "electron",
    "knowledge-base"
  ],
  "author": "lo Project",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@lo/client": "file:../lo-client-sdk",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
